    "class VerificationTimerMixin:\n",
    "    def verifyZKProof(self, *args, **kwargs):\n",
    "        start = time.perf_counter()\n",
    "        try:\n",
    "            return super().verifyZKProof(*args, **kwargs)\n",
    "        finally:\n",
    "            self.last_verify_seconds = time.perf_counter() - start\n",
    "\n",
    "\n",
    "class TimedNoMerkleSystem(VerificationTimerMixin, ZKVotingSystem):\n",
    "    pass\n",
    "\n",
    "\n",
    "class TimedMerkleSystem(VerificationTimerMixin, ZKMerkleVotingSystem):\n",
    "    pass"
   ]
  },
